# Copy to .env.local and fill in your values

# App
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=
SUPABASE_DB_PASSWORD=

# Moolre — payments
MOOLRE_API_USER=YOUR_MOOLRE_API_USER
MOOLRE_API_PUBKEY=YOUR_MOOLRE_API_PUBKEY
MOOLRE_ACCOUNT_NUMBER=YOUR_MOOLRE_ACCOUNT_NUMBER
MOOLRE_MERCHANT_EMAIL=noreply@yourdomain.com
MOOLRE_CALLBACK_SECRET=YOUR_MOOLRE_CALLBACK_SECRET

# Moolre — SMS
MOOLRE_SMS_API_KEY=YOUR_MOOLRE_SMS_API_KEY
MOOLRE_API_KEY=YOUR_MOOLRE_API_KEY
SMS_SENDER_ID=YOUR_SENDER_ID

# Email — Resend
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=YOUR_STORE <noreply@yourdomain.com>
ADMIN_EMAIL=support@yourdomain.com

# Security (optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
CRON_SECRET=YOUR_CRON_SECRET

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Scripts
CREATE_ADMIN_EMAIL=
CREATE_ADMIN_PASSWORD=
